{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!**/*.md", "!package-lock.json", "!lint-all"]
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUndeclaredDependencies": "error" },
      "complexity": { "noExcessiveCognitiveComplexity": "error" }
    }
  },
  "plugins": [
    "./biome-plugins/array-generic-form.grit",
    "./biome-plugins/no-destructured-parameter.grit",
    "./biome-plugins/no-type-assertion.grit"
  ]
}

#!/usr/bin/env node
// Exits non-zero if any dependency in package.json isn't an exact x.y.z version.
import { readFileSync } from "node:fs";

const SECTIONS = [
  "dependencies",
  "devDependencies",
  "optionalDependencies",
  "peerDependencies",
];
const EXACT = /^\d+\.\d+\.\d+$/;

const pkgPath = process.argv[2] ?? "package.json";
const pkg = JSON.parse(readFileSync(pkgPath, "utf8"));

const bad = SECTIONS.flatMap((section) =>
  Object.entries(pkg[section] ?? {})
    .filter(([, version]) => !EXACT.test(version))
    .map(([name, version]) => `${section}: ${name}@${version}`),
);

if (bad.length > 0) {
  console.error("Dependencies must be exact x.y.z versions:");
  for (const line of bad) console.error(`  ${line}`);
  process.exit(1);
}

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
ts=$(printf '%s\n' "$files" | grep -E '\.ts$' || true)
bin=./node_modules/.bin
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT

run() {
  name=$1; shift
  "$@" >"$out/$name.log" 2>&1 || echo "$name" >>"$out/failed"
}

run biome "$bin/biome" check --staged --error-on-warnings --no-errors-on-unmatched &
run tsc "$bin/tsc" --noEmit &
[ -n "$ts" ] && run comments node scripts/check-comments.js $ts &
[ -n "$ts" ] && run vitest "$bin/vitest" related --run --passWithNoTests $ts &
wait

[ -f "$out/failed" ] || exit 0
for name in $(cat "$out/failed"); do
  echo "pre-commit: $name failed" >&2
  cat "$out/$name.log" >&2
done
exit 1

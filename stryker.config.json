{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/trace/**/*.ts",
    "src/algorithms/**/*.ts",
    "!src/**/*.test.ts",
    "!src/algorithms/fixtures/**"
  ],
  "thresholds": { "high": 90, "low": 85, "break": 80 }
}

{
  "name": "dsa-visualizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check-exact-deps": "node scripts/check-exact-deps",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome ci && npm run check-comments",
    "test": "vitest run",
    "check-comments": "node scripts/check-comments.js",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
